ARG CUDA_VERSION=12.4.1
ARG OS_VERSION=22.04
FROM nvidia/cuda:${CUDA_VERSION}-base-ubuntu${OS_VERSION}

ARG PYTHON_VERSION=3.12

ENV DEBIAN_FRONTEND=noninteractive \
    MUJOCO_GL=egl \
    PATH=/lerobot/.venv/bin:$PATH \
    CUDA_VISIBLE_DEVICES=0 \
    TEST_TYPE=single_gpu \
    DEVICE=cuda \
    # Isaac Sim EULAs automatisch akzeptieren
    ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y

# 1. System updaten und Headless-Tools installieren (VNC & XFCE WURDEN ENTFERNT)
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common build-essential git curl \
    libglib2.0-0 libgl1-mesa-glx libegl1-mesa ffmpeg \
    libusb-1.0-0-dev speech-dispatcher libgeos-dev portaudio19-dev \
    cmake pkg-config ninja-build openssh-client \
    libopengl0 libglvnd-dev \
    # --- Isaac Sim / Vulkan / EGL Headless Abhängigkeiten ---
    libvulkan1 vulkan-tools libxcursor1 libxrandr2 libxinerama1 libx11-xcb1 libxi6 \
    sudo ca-certificates gnupg lsb-release \
    && rm -rf /var/lib/apt/lists/*

# (Optional: Docker-in-Docker Setup beibehalten, falls es für andere Dinge gebraucht wird)
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
    $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# 2. Python und UV installieren
RUN add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       python${PYTHON_VERSION} \
       python${PYTHON_VERSION}-venv \
       python${PYTHON_VERSION}-dev \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && useradd --create-home --shell /bin/bash user_lerobot \
    && usermod -aG sudo,docker user_lerobot \
    && echo "user_lerobot ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /lerobot
RUN chown -R user_lerobot:user_lerobot /lerobot

USER user_lerobot

ENV HOME=/home/user_lerobot \
    HF_HOME=/home/user_lerobot/.cache/huggingface \
    HF_LEROBOT_HOME=/home/user_lerobot/.cache/huggingface/lerobot \
    TORCH_HOME=/home/user_lerobot/.cache/torch \
    TRITON_CACHE_DIR=/home/user_lerobot/.cache/triton

# 3. Das gemeinsame Python Environment erstellen
RUN uv venv --python python${PYTHON_VERSION}

COPY --chown=user_lerobot:user_lerobot pyproject.toml uv.lock ./
# LeRobot Abhängigkeiten installieren
RUN uv sync --locked --extra all --no-cache --no-install-project

# Visualisierungstool Mujoco
RUN uv pip install mujoco-python-viewer meshcat

# Isaac Sim 6 für Python 3.12 nativ hinzufügen
RUN uv pip install "isaacsim[all,extscache]==6.0.1.0" --extra-index-url https://pypi.nvidia.com --index-strategy unsafe-best-match --prerelease=allow

RUN chmod +x /lerobot/.venv/lib/python${PYTHON_VERSION}/site-packages/triton/backends/nvidia/bin/ptxas

# (Cloud GUI Entrypoint kann bleiben, wird aber eigentlich nicht mehr zwingend benötigt)
COPY --chown=user_lerobot:user_lerobot docker/entrypoint_cloud_gui.sh /lerobot/entrypoint_cloud_gui.sh
RUN chmod +x /lerobot/entrypoint_cloud_gui.sh

WORKDIR /lerobot

ENTRYPOINT ["/bin/bash", "-c", "source /lerobot/.venv/bin/activate && exec /bin/bash"]